# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Required on Vercel for persistent application data.
# Configure this in the deployment platform's environment variables.
DATABASE_URL="YOUR_NEON_POSTGRES_CONNECTION_STRING"

# S3-compatible file storage: Set all five values to enable persistent uploads.
AWS_ENDPOINT_URL_S3="YOUR_S3_COMPATIBLE_ENDPOINT"
AWS_ACCESS_KEY_ID="YOUR_STORAGE_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_STORAGE_SECRET_ACCESS_KEY"
AWS_REGION="us-east-2"
AWS_BUCKET_NAME="assets"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Institutional SMTP Configuration for OTP email delivery (Optional)
# If omitted, defaults to automated SMTP transporter
SMTP_HOST="smtp.gprec.ac.in"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="academic-hub@gprec.ac.in"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="GPREC Academic Hub <noreply@gprec.ac.in>"
